      "fieldname": "receipt_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Receipt Type",
      "options": "Engineer Request\nVoice of Customer",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Customer",
      "options": "Customer",
      "reqd": 1
    },
    {
      "fieldname": "target_site",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Target Site",
      "options": "WMS Site",
      "reqd": 1
    },
    {
      "fieldname": "related_engineer",
      "fieldtype": "Link",
      "label": "Requesting Engineer",
      "options": "Employee"
    },
    {
      "depends_on": "eval:doc.receipt_type=='Engineer Request'",
      "fieldname": "engineer_request_reference",
      "fieldtype": "Data",
      "label": "Engineer Request Reference"
    },
    {
      "fieldname": "receiving_section",
      "fieldtype": "Section Break",
      "label": "Receiving Details"
    },
    {
      "fieldname": "receiving_warehouse",
      "fieldtype": "Link",
      "label": "Receiving Warehouse",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "default": "Today",
