    },
    {
      "fieldname": "dispatch_date",
      "fieldtype": "Date",
      "label": "Dispatch Date",
      "read_only": 1
    },
    {
      "fieldname": "dispatched_by",
      "fieldtype": "Link",
      "label": "Dispatched By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "days_in_warehouse",
      "fieldtype": "Int",
      "in_list_view": 1,
      "label": "Days in Warehouse",
      "read_only": 1
    },
    {
      "fieldname": "is_overdue",
      "fieldtype": "Check",
      "in_filter": 1,
      "in_list_view": 1,
      "label": "Overdue",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "HTT Material Receipt",
      "print_hide": 1,
      "read_only": 1
    }
