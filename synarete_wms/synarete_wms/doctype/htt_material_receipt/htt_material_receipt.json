      "label": "Customer Materials"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "HTT Material Item"
    },
    {
      "fieldname": "dispatch_section",
      "fieldtype": "Section Break",
      "label": "Dispatch"
    },
    {
      "default": "Pending",
      "fieldname": "dispatch_status",
      "fieldtype": "Select",
      "in_filter": 1,
      "in_list_view": 1,
      "label": "Dispatch Status",
      "options": "Pending\nPartially Dispatched\nDispatched",
