{
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "item_code",
    "item_name",
    "requested_qty",
    "approved_qty",
    "previous_outstanding_qty",
    "use_outstanding",
    "outstanding_applied_qty",
    "warehouse_stock_qty",
    "accountability",
    "qty",
    "fulfilled_qty",
    "uom",
    "material_type",
    "serial_no",
    "batch_no",
    "remarks"
  ],
  "fields": [
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Item",
      "options": "Item",
      "reqd": 1
    },
    {
      "fetch_from": "item_code.item_name",
      "fieldname": "item_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Item Name",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "fieldname": "requested_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Requested Quantity",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "fieldname": "approved_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Approved Quantity",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "default": "0",
      "fieldname": "previous_outstanding_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Engineer Available Stock",
      "description": "Leftover Field Issued quantity already held by this engineer. Not a second warehouse.",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "default": "0",
      "fieldname": "use_outstanding",
      "fieldtype": "Check",
      "in_list_view": 1,
      "label": "Use Outstanding Stock",
      "description": "Apply engineer leftover toward this work order. Reused qty does not create another Stock Entry."
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "default": "0",
      "fieldname": "outstanding_applied_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Quantity Reused",
      "description": "Quantity allocated from engineer leftover. Stays in Field Issued Warehouse.",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "default": "0",
      "fieldname": "warehouse_stock_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Main Warehouse Available",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "fieldname": "accountability", 
      "fieldtype": "Link",
      "label": "Material Accountability",
      "options": "WMS Material Accountability",
      "read_only": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Additional from Main Warehouse",
      "description": "Physical transfer from Main Warehouse. Reused leftover is not included. For HTT this is the dispatch quantity.",
      "mandatory_depends_on": "eval:!doc.use_outstanding || doc.approved_qty > doc.outstanding_applied_qty"
    },
    {
      "depends_on": "eval:doc.material_type=='MP' || doc.material_type=='Both'",
      "default": "0",
      "fieldname": "fulfilled_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Total Fulfilled Quantity",
      "read_only": 1
    },
    {
      "fetch_from": "item_code.stock_uom",
      "fieldname": "uom",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "UOM",
      "options": "UOM"
    },
    {
      "fieldname": "material_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Material Type",
      "options": "\nMP\nHTT"
    },
    {
      "fieldname": "serial_no",
      "fieldtype": "Small Text",
      "label": "Serial No"
    },
    {
      "fieldname": "batch_no",
      "fieldtype": "Link",
      "label": "Batch No",
      "options": "Batch"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks"
    }
  ],
  "istable": 1,
  "module": "Synarete WMS",
  "name": "WMS Material Issue Item"
}
