{
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Item",
      "options": "Item",
      "reqd": 1
    },
    {
      "fetch_from": "item_code.item_name",
      "fieldname": "item_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Item Name",
      "read_only": 1
    },
    {
      "default": "1",
      "fieldname": "is_fixed_qty",
      "fieldtype": "Check",
      "in_list_view": 1,
      "label": "Fixed Quantity"
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Quantity",
      "reqd": 1
    },
    {
      "fetch_from": "item_code.stock_uom",
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM"
    },
    {
      "default": "0",
      "fieldname": "issued_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Issued Quantity",
      "read_only": 1
    },
    {
      "default": "0",
      "fieldname": "balance_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Balance",
      "read_only": 1
    },
    {
      "depends_on": "eval:!doc.is_fixed_qty",
      "fieldname": "varies_by",
      "fieldtype": "Select",
      "label": "Varies By",
      "options": "\nGenerator Type\nEngine Type\nSite Load"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks"
    }
  ],
  "istable": 1,
  "module": "Synarete WMS",
  "name": "Monthly Service Item"
}
