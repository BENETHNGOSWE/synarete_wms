      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Part Name"
    },
    {
      "fieldname": "part_category",
      "fieldtype": "Data",
      "label": "Part Category"
    },
    {
      "fieldname": "part_group",
      "fieldtype": "Data",
      "label": "Part Group"
    },
    {
