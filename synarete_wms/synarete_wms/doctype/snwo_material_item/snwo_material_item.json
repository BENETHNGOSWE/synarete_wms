    {
      "default": "0",
      "fieldname": "qty_mp_issued",
      "fieldtype": "Float",
      "label": "Qty Issued from MP Stock",
      "read_only": 1
    },
    {
      "fetch_from": "item_code.stock_uom",
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM"
