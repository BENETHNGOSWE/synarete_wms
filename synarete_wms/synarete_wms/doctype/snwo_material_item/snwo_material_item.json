{
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "item_code",
    "part_name",
    "part_category",
    "part_group",
    "material_source",
    "qty_requested",
    "qty_received",
    "qty_issued",
    "qty_consumed",
    "qty_remaining",
    "qty_warehouse_remaining",
