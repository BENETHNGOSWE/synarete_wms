{
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Item",
      "options": "Item",
      "reqd": 1
    },
    {
      "fetch_from": "item_code.item_name",
      "fieldname": "item_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Item Name",
      "read_only": 1
    },
    {
      "fieldname": "material_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Material Type",
      "options": "\nMP\nHTT"
    },
    {
      "default": "0",
      "fieldname": "system_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "System Quantity",
      "read_only": 1
    },
    {
      "fieldname": "physical_qty",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Physical Quantity"
    },
    {
      "default": "0",
      "fieldname": "variance",
      "fieldtype": "Float",
      "in_list_view": 1,
      "label": "Variance",
      "read_only": 1
    },
    {
      "fetch_from": "item_code.stock_uom",
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM"
    },
    {
      "fieldname": "engine_type",
      "fieldtype": "Data",
      "label": "Engine Type"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks"
    }
  ],
  "istable": 1,
  "module": "Synarete WMS",
  "name": "Stock Taking Item"
}
